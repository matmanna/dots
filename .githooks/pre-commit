#!/usr/bin/env bash
# Blocks commits that could leak plaintext secrets. Bypass only on purpose,
# with `git commit --no-verify`.
set -euo pipefail

fail=0

# 1. Everything staged under secrets/ (except the recipients list) must be an
#    age-encrypted file.
while IFS= read -r f; do
  case "$f" in
    secrets/secrets.nix) continue ;;
    secrets/*)
      if [ "$(git show ":$f" | head -c 21)" != "age-encryption.org/v1" ]; then
        echo "pre-commit: $f is staged but not age-encrypted (use agenix -e)" >&2
        fail=1
      fi
      ;;
  esac
done < <(git diff --cached --name-only --diff-filter=ACMR)

# 2. Scan staged changes for anything that looks like a credential.
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks=(gitleaks)
else
  gitleaks=(nix run nixpkgs#gitleaks --)
fi
if ! "${gitleaks[@]}" git --staged --no-banner --redact --exit-code 1 . >&2; then
  echo "pre-commit: gitleaks found a possible secret in the staged changes" >&2
  fail=1
fi

exit "$fail"
