Host *
  # gcr-ssh-agent (GNOME Keyring); works even in processes started
  # before SSH_AUTH_SOCK was exported, like a running herdr server.
  IdentityAgent ${XDG_RUNTIME_DIR}/gcr/ssh
  AddKeysToAgent yes

# Over Tailscale (MagicDNS). Public port 22 is closed; if the tailnet is down,
# use the Contabo VNC console. Root: `ssh trench` then `sudo -i`.
Host trench
  HostName trench.tail4a3e06.ts.net
  User matmanna
  IdentityFile ~/.ssh/id_ed25519
